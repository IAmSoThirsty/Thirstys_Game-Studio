# .dockerignore for Game Docker build

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github

# Documentation
*.md
!README.md
docs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Android (KEEP app/*.py but exclude Android build files)
android/
app/build.gradle
app/proguard-rules.pro
app/src/
build.gradle
settings.gradle
gradlew
gradlew.bat
gradle/
*.apk
*.aab
.gradle/

# Other language interfaces
cpp/
dotnet/
web/

# Output artifacts
output/
saves/

# Agent system (not needed for game)
agent/

# Other Dockerfiles
Dockerfile
docker-compose.yml

# Setup scripts
setup.sh
setup.ps1
Makefile

# Kubernetes
k8s/
